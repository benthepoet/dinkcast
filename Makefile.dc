# SPDX-License-Identifier: GPL-3.0-or-later
# Dreamcast ELF (Bite 0.2). Invoke via `make dc` with KOS_BASE set.
TARGET = build/dinkcast.elf
OBJS = src/main.o src/fs.o src/le.o src/bmp.o src/rgb565.o src/dinkdat.o src/title.o src/pad.o \
	src/world.o src/mapscr.o src/tiles.o src/ff.o src/ini.o src/hard.o src/sprite.o \
	src/player.o src/edraw.o src/talk.o src/hit.o src/script.o src/dinkc_file.o \
	src/dinkc_lex.o src/dinkc_parse.o src/dinkc_vm.o src/dinkc_var.o src/dinkc_cmd.o

KOS_CFLAGS += -Isrc
# Do not -DDINK_DATA_DEFAULT from local.mk: that path is a host tree
# (slashes/quotes break kos-cc) and does not exist on the Dreamcast.
# Runtime probe is /pc/dink, /cd/dink, then getenv("DINK_DATA").

all: $(TARGET)

include $(KOS_BASE)/Makefile.rules

$(TARGET): $(OBJS) | build
	kos-cc -o $@ $(OBJS)

build:
	mkdir -p build

clean:
	-rm -f $(OBJS) $(TARGET)
